# Supabase — get these from https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HOSPITAL_NAME="District General Hospital"
NEXT_PUBLIC_HOSPITAL_TAGLINE="Govt. of India · जिला अस्पताल"
NEXT_PUBLIC_HELPDESK_PHONE=1800-180-1104

# Feature flags
NEXT_PUBLIC_USE_MOCK_DATA=true   # set to false when Supabase is wired up
